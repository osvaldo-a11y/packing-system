# Entorno DEMO AISLADO (local). NO usar contra producción.
# Copiar a .env o exportar estas variables antes de levantar el API.
# Nunca definir DEMO_SANDBOX=true en el servicio Railway de producción.

PORT=3000
NODE_ENV=development
RUN_MIGRATIONS_ON_STARTUP=true

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
# Base independiente de packing_system / de producción.
DB_NAME=packing_demo

JWT_SECRET=demo-sandbox-local-not-for-production
JWT_EXPIRES_IN=8h

AUTH_USERS_JSON='[{"username":"admin","password":"admin123","role":"admin"},{"username":"supervisor","password":"sup123","role":"supervisor"},{"username":"operator","password":"op123","role":"operator"}]'

DEMO_SANDBOX=true
DEMO_USER_ENABLED=true
DEMO_USERNAME=admin.demo
DEMO_PASSWORD=demo123
DEMO_USER_ROLE=admin
DEMO_SHOW_CREDENTIALS=true

COMPANY_DISPLAY_NAME="Pinebloom Farms"
